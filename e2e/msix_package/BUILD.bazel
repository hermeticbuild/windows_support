load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@windows_support//windows:msix.bzl", "msix_package")

# The package layout, a tree artifact with `AppxManifest.xml` at its root.
copy_to_directory(
    name = "layout",
    srcs = ["manifests/AppxManifest.xml"] + glob(["app/**"]),
    root_paths = [
        "app",
        "manifests",
    ],
)

msix_package(
    name = "app_msix",
    layout_dir = ":layout",
)

msix_package(
    name = "app_appx",
    out = "app_appx.appx",
    layout_dir = ":layout",
)

# Packages are not reproducible, so they are checked by unpacking them back. makemsix validates the
# package on unpack, the block map hashes included, `-ss` skips the signature that we don't have.
[
    run_binary(
        name = "{}_unpacked".format(package),
        srcs = [":" + package],
        args = [
            "unpack",
            "-ss",
            "-p",
            "$(execpath :{})".format(package),
            "-d",
            "$(RULEDIR)/{}_unpacked".format(package),
        ],
        out_dirs = ["{}_unpacked".format(package)],
        tool = "@msix_packaging//:makemsix",
    )
    for package in [
        "app_msix",
        "app_appx",
    ]
]

# Drops the `AppxBlockMap.xml` generated by makemsix, the rest is the layout.
[
    copy_to_directory(
        name = "{}_payload".format(package),
        srcs = [":{}_unpacked".format(package)],
        exclude_srcs_patterns = ["AppxBlockMap.xml"],
        root_paths = ["{}_unpacked".format(package)],
    )
    for package in [
        "app_msix",
        "app_appx",
    ]
]

[
    diff_test(
        name = "{}_test".format(package),
        file1 = ":layout",
        file2 = ":{}_payload".format(package),
    )
    for package in [
        "app_msix",
        "app_appx",
    ]
]
